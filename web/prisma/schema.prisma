// EcoSphere ESG Management Platform
// Prisma Schema — Full model definitions
// Owner: Rudra (schema merge authority)
// Do NOT edit this file directly — open a PR/diff first

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  EMPLOYEE
  DEPT_HEAD // data field only in v1; no special UI logic yet
}

enum Status {
  ACTIVE
  INACTIVE
}

enum CategoryType {
  CSR_ACTIVITY
  CHALLENGE
}

enum CarbonSource {
  PURCHASE
  MANUFACTURING
  EXPENSE
  FLEET
  MANUAL
}

enum GoalStatus {
  ACTIVE
  ON_TRACK
  AT_RISK
  COMPLETED
}

enum ActivityStatus {
  OPEN
  CLOSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditStatus {
  SCHEDULED
  COMPLETED
  UNDER_REVIEW
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  RESOLVED
  OVERDUE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  COMPLETED
  ARCHIVED
}

enum TreeStage {
  SEED
  SAPLING
  YOUNG
  MATURE
}

enum ShopItemType {
  WATER
  SEED
  FERTILIZER
  DECORATION
}

enum ScoreType {
  ENVIRONMENTAL
  SOCIAL
}

enum NotifType {
  COMPLIANCE_ISSUE
  CSR_APPROVAL
  CHALLENGE_APPROVAL
  POLICY_REMINDER
  BADGE_UNLOCK
  GENERAL
}

// ─── Identity & Org ──────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  employee     Employee?
  notifications Notification[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Department {
  id              String       @id @default(cuid())
  name            String
  code            String       @unique
  headId          String?
  parentId        String?
  parent          Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children        Department[] @relation("DeptHierarchy")
  employees       Employee[]
  status          Status       @default(ACTIVE)
  // Relations to transactional models
  carbonTransactions CarbonTransaction[]
  environmentalGoals EnvironmentalGoal[]
  csrActivities   CSRActivity[]
  audits          Audit[]
  complianceIssues ComplianceIssue[]
  departmentScore DepartmentScore?
  scoreFeedback   ScoreFeedback[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Employee {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  xp           Int       @default(0)
  level        Int       @default(1)
  ecoCoins     Int       @default(0)
  gender       String?
  joinedAt     DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // Relations
  participations      EmployeeParticipation[]
  trainingRecords     TrainingRecord[]
  challengeParticipations ChallengeParticipation[]
  badges              EmployeeBadge[]
  rewardRedemptions   RewardRedemption[]
  garden              Garden?
  inventoryPurchases  InventoryPurchase[]
  policyAcknowledgements PolicyAcknowledgement[]
}

// ─── Shared Master Data ───────────────────────────────────────────────────────

model Category {
  id           String       @id @default(cuid())
  name         String
  type         CategoryType
  status       Status       @default(ACTIVE)
  csrActivities CSRActivity[]
  challenges   Challenge[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model EmissionFactor {
  id          String @id @default(cuid())
  activity    String // e.g. "Diesel (litre)", "Electricity (kWh)"
  factorKgCO2 Float
  unit        String
  source      String?
  carbonTransactions CarbonTransaction[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductESGProfile {
  id          String  @id @default(cuid())
  productName String
  co2PerUnit  Float
  recyclable  Boolean @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Environmental ────────────────────────────────────────────────────────────

model EnvironmentalGoal {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  targetCO2Kg  Float
  currentCO2Kg Float      @default(0)
  deadline     DateTime
  status       GoalStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CarbonTransaction {
  id               String         @id @default(cuid())
  departmentId     String
  department       Department     @relation(fields: [departmentId], references: [id])
  sourceType       CarbonSource
  quantity         Float
  emissionFactorId String
  emissionFactor   EmissionFactor @relation(fields: [emissionFactorId], references: [id])
  co2Kg            Float          // quantity * factor, computed on write in Server Action
  autoGenerated    Boolean        @default(false)
  notes            String?
  date             DateTime       @default(now())
  createdAt        DateTime       @default(now())
}

// ─── Social ───────────────────────────────────────────────────────────────────

model CSRActivity {
  id               String         @id @default(cuid())
  title            String
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  description      String
  departmentId     String?
  department       Department?    @relation(fields: [departmentId], references: [id])
  evidenceRequired Boolean        @default(true)
  xpReward         Int            @default(50) // XP awarded on approval
  status           ActivityStatus @default(OPEN)
  createdBy        String         // admin userId
  participations   EmployeeParticipation[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model EmployeeParticipation {
  id           String         @id @default(cuid())
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id])
  activityId   String
  activity     CSRActivity    @relation(fields: [activityId], references: [id])
  proofUrl     String?
  approval     ApprovalStatus @default(PENDING)
  pointsEarned Int            @default(0)
  completedAt  DateTime?
  reviewedBy   String?        // admin userId
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@unique([employeeId, activityId])
}

model TrainingRecord {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

// ─── Governance ───────────────────────────────────────────────────────────────

model ESGPolicy {
  id               String    @id @default(cuid())
  title            String
  body             String
  version          Int       @default(1)
  createdBy        String    // admin userId
  acknowledgements PolicyAcknowledgement[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PolicyAcknowledgement {
  id             String    @id @default(cuid())
  policyId       String
  policy         ESGPolicy @relation(fields: [policyId], references: [id])
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([employeeId, policyId])
}

model Audit {
  id              String      @id @default(cuid())
  title           String
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])
  auditorName     String
  date            DateTime
  findingsSummary String?
  status          AuditStatus @default(SCHEDULED)
  complianceIssues ComplianceIssue[]
  createdBy       String      // admin userId
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model ComplianceIssue {
  id           String      @id @default(cuid())
  auditId      String?
  audit        Audit?      @relation(fields: [auditId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  severity     Severity
  description  String
  ownerId      String      // userId of the owner (must be assigned)
  dueDate      DateTime
  status       IssueStatus @default(OPEN)
  resolvedAt   DateTime?
  resolvedBy   String?     // userId
  createdBy    String      // admin userId
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// ─── Gamification ─────────────────────────────────────────────────────────────

model Challenge {
  id               String           @id @default(cuid())
  title            String
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  description      String
  xp               Int
  difficulty       Difficulty
  evidenceRequired Boolean          @default(true)
  deadline         DateTime
  status           ChallengeStatus  @default(DRAFT)
  createdBy        String           // admin userId
  participations   ChallengeParticipation[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ChallengeParticipation {
  id          String         @id @default(cuid())
  challengeId String
  challenge   Challenge      @relation(fields: [challengeId], references: [id])
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id])
  progress    Int            @default(0) // 0–100
  proofUrl    String?
  approval    ApprovalStatus @default(PENDING)
  xpAwarded   Int            @default(0)
  completedAt DateTime?
  reviewedBy  String?        // admin userId
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([challengeId, employeeId])
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String   // lucide icon name or emoji
  // unlockRule examples:
  //   { "type": "XP_THRESHOLD", "value": 500 }
  //   { "type": "CHALLENGE_COUNT", "value": 5 }
  //   { "type": "CSR_COUNT", "value": 3 }
  unlockRule  String   // stored as JSON string (SQLite has no native JSON column)
  employeeBadges EmployeeBadge[]
  createdAt   DateTime @default(now())
}

model EmployeeBadge {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id])
  unlockedAt DateTime @default(now())

  @@unique([employeeId, badgeId])
}

model Reward {
  id             String   @id @default(cuid())
  name           String
  description    String
  pointsRequired Int
  stock          Int      @default(0) // -1 = unlimited
  status         Status   @default(ACTIVE)
  redemptions    RewardRedemption[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RewardRedemption {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  rewardId   String
  reward     Reward   @relation(fields: [rewardId], references: [id])
  redeemedAt DateTime @default(now())
}

// ─── Virtual Garden (novelty feature) ────────────────────────────────────────

model Garden {
  id           String   @id @default(cuid())
  employeeId   String   @unique
  employee     Employee @relation(fields: [employeeId], references: [id])
  growthScore  Int      @default(0)  // leaderboard ranking key
  waterLevel   Int      @default(100) // 0–100, decays ~5%/day (computed on read)
  lastWatered  DateTime @default(now())
  trees        Tree[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tree {
  id            String    @id @default(cuid())
  gardenId      String
  garden        Garden    @relation(fields: [gardenId], references: [id])
  species       String    // seed type purchased from shop
  stage         TreeStage @default(SEED)
  carePoints    Int       @default(0) // accumulates; determines stage advancement
  plantedAt     DateTime  @default(now())
  lastWateredAt DateTime  @default(now())
}

model ShopItem {
  id        String       @id @default(cuid())
  name      String       // "Water Can", "Oak Seed", "Fertilizer", etc.
  type      ShopItemType
  costCoins Int
  stock     Int?         // null = unlimited
  status    Status       @default(ACTIVE)
  purchases InventoryPurchase[]
  createdAt DateTime     @default(now())
}

model InventoryPurchase {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  shopItemId  String
  shopItem    ShopItem  @relation(fields: [shopItemId], references: [id])
  quantity    Int
  totalCost   Int       // coins spent
  purchasedAt DateTime  @default(now())
}

// ─── Scoring & Rollups ────────────────────────────────────────────────────────

model DepartmentScore {
  id             String     @id @default(cuid())
  departmentId   String     @unique
  department     Department @relation(fields: [departmentId], references: [id])
  environmental  Float      @default(0)
  social         Float      @default(0)
  governance     Float      @default(0)
  total          Float      @default(0)
  isFallback     Boolean    @default(false) // true when ML service was down
  computedAt     DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model ESGConfig {
  id              String  @id @default(cuid())
  // Weights must sum to 1.0
  envWeight       Float   @default(0.4)
  socialWeight    Float   @default(0.3)
  govWeight       Float   @default(0.3)
  // Feature toggles
  autoEmission    Boolean @default(true)
  requireEvidence Boolean @default(true)
  autoBadgeAward  Boolean @default(true)
  emailAlerts     Boolean @default(false)
  // XP/EcoCoin settings
  xpToCoinRatio   Int     @default(1) // 1 XP = 1 EcoCoin (configurable)
  updatedAt       DateTime @updatedAt
}

// ScoreFeedback — logs every ML prediction for future retraining
// also stores admin overrides (correctedScore) as higher-quality labels
model ScoreFeedback {
  id             String    @id @default(cuid())
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])
  scoreType      ScoreType
  features       String    // JSON string of feature vector used for this prediction
  predictedScore Float
  correctedScore Float?    // admin override; becomes the training label when present
  createdAt      DateTime  @default(now())
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  type      NotifType
  title     String
  body      String
  read      Boolean    @default(false)
  link      String?    // e.g. "/governance/compliance/clxyz123"
  createdAt DateTime   @default(now())
}
